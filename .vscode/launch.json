{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Backend (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--port",
                "8081"
            ],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "justMyCode": true,
            "python": "${workspaceFolder}/backend/venv/bin/python"
        }
    ],
    "compounds": [
        {
            "name": "Octa Desktop (Full Stack)",
            "configurations": ["Run Backend (FastAPI)"],
            "preLaunchTask": "Start Frontend (Vite)",
            "stopAll": true
        }
    ]
}
