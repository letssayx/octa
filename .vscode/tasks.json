{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Frontend (Vite)",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*VITE.*ready in.*$",
                    "endsPattern": "^.*VITE.*ready in.*$"
                }
            },
            "presentation": {
                "group": "octadesktop",
                "panel": "shared"
            }
        },
        {
            "label": "Install Frontend Dependencies",
            "type": "npm",
            "script": "install",
            "path": "frontend",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}