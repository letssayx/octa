{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Frontend (Vite)",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*VITE.*ready in.*$",
                    "endsPattern": "^.*VITE.*ready in.*$"
                }
            },
            "presentation": {
                "group": "octadesktop",
                "panel": "shared"
            }
        },
        {
            "label": "Install Backend Dependencies",
            "type": "shell",
            "command": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Install Frontend Dependencies",
            "type": "npm",
            "script": "install",
            "path": "frontend",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
